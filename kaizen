name: Verify Human Identity

on:
workflow_dispatch:
inputs:
agent_name:
description: 'Agent Name'
required: true
default: 'onsu'
agent_description:
description: 'Agent Description'
required: true
default: 'onsu AI Agent'

jobs:
verify:
runs-on: ubuntu-latest

```
steps:
  - name: Checkout repository
    uses: actions/checkout@v4

  - name: Setup Node.js
    uses: actions/setup-node@v4
    with:
      node-version: '20'

  - name: Install ClawHub skill
    run: npx clawhub@latest install verified-agent-identity

  - name: Install dependencies
    run: |
      if [ -d "scripts" ]; then
        cd scripts
        npm install
      fi

  - name: Create new Ethereum Identity
    run: node scripts/createNewEthereumIdentity.js

  - name: Link Human to Agent
    run: |
      node scripts/manualLinkHumanToAgent.js \
      --challenge "{\"name\":\"${{ github.event.inputs.agent_name }}\",\"description\":\"${{ github.event.inputs.agent_description }}\"}"
```
